# Required. Never keep example or shared credentials here.
APP_PASSWORD=
AUTH_SECRET=
COMFY_URL=http://host.docker.internal:8188
FRONTEND_PORT=5173

# Comma-separated public frontend origins when the API is exposed cross-origin.
CORS_ORIGINS=

# Additional exact service origins users may configure, for example:
# SERVICE_URL_ALLOWLIST=http://host.docker.internal:11434
SERVICE_URL_ALLOWLIST=

# Allow literal loopback/private-network service IPs on any port.
ALLOW_PRIVATE_SERVICE_URLS=false

# Set to true when each authenticated user may configure a different LLM URL.
ALLOW_USER_LLM_URLS=false
